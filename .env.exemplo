# Copie para .env.local (fora do git: o repositório é público). Só o servidor do Next lê estas variáveis.

# 1 = modo de demonstração: o próprio Next responde com a Casa Vila Nova (dados fictícios, em memória).
CANTEIRO_DEMO=1

# Com CANTEIRO_DEMO vazio, o Next repassa para os serviços de verdade:
API_URL=http://localhost:8000
AGENTE_URL=http://localhost:8100

# A API lê o IP do cliente (limite de tentativas no login) do X-Forwarded-For que o Next repassa, mas só confia nele
# vindo de um IP listado em TRUSTED_PROXIES no .env DA API. Ponha lá o IP deste servidor do Next (em local: 127.0.0.1).
#
# Fora da Vercel, o X-Forwarded-For que chega ao Next pode ter sido escrito pelo próprio visitante; repassado, ele
# escaparia do limite por IP do login. Por isso o Next só o repassa (e o x-canteiro-ip-cliente do PROXY_SEGREDO) com
# CONFIAR_XFF=1, que só deve ser ligado com um proxy de confiança na frente que SOBRESCREVE o cabeçalho (não que
# acrescenta a ele). Sem isso, a API usa o endereço da conexão. Na Vercel (VERCEL definida pela plataforma) é automático.
CONFIAR_XFF=

# Tradutor de pranchas (opcional): lê a prancha estrutural (PDF do CAD ou imagem) e devolve os dados e o modelo 3D
# da tela Projeto 3D. Funciona também com CANTEIRO_DEMO=1. A chave é a de TRADUTOR_API_KEYS do serviço.
TRADUTOR_URL=
TRADUTOR_CHAVE=
