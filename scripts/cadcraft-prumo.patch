+
+// ---------------------------------------------------------------------------------------------
+// Prumo: comandos da página hospedeira. Além de abrir e salvar (o contrato do craft-web-host), a
+// página que embute o CAD pode pedir um comando do catálogo (o mesmo da linha de comando e do
+// `cadcraft-cli run --cmd`), por exemplo ir até um elemento: `zoom.window` e `select`.
+//
+//   página -> app: { type: "cadcraft:execute", pedido, id, params }
+//   app -> página: { type: "cadcraft:executed", pedido, ok, result | error }
+//
+// Só a janela que embute o app, na mesma origem, é ouvida e respondida (a mesma regra do bridge).
+// ---------------------------------------------------------------------------------------------
+
+thread_local! {
+    /// Pedidos da página que esperam o próximo quadro: `(pedido, id, params)`.
+    static PEDIDOS: RefCell<Vec<(String, String, serde_json::Value)>> = const { RefCell::new(Vec::new()) };
+}
+
+/// A janela que embute o app, se ela estiver na mesma origem; `None` fora de um iframe.
+fn parent_mesma_origem() -> Option<(web_sys::Window, String)> {
+    let window = web_sys::window()?;
+    let parent = window.parent().ok().flatten()?;
+    if wasm_bindgen::JsValue::from(parent.clone()) == wasm_bindgen::JsValue::from(window.clone()) {
+        return None; // sem iframe: a própria janela
+    }
+    let origem = window.location().origin().ok()?;
+    // outra origem: ler a location dela lança, e o app segue como se não estivesse embutido
+    let origem_parent = parent.location().origin().ok()?;
+    (origem_parent == origem).then_some((parent, origem))
+}
+
+/// Começa a ouvir `cadcraft:execute`. O comando roda no próximo quadro (`run_pending`), dentro do
+/// laço do app, como um comando digitado.
+pub fn listen_execute(ctx: &egui::Context) {
+    use wasm_bindgen::JsCast;
+    use wasm_bindgen::closure::Closure;
+    let Some((parent, origem)) = parent_mesma_origem() else { return };
+    let Some(window) = web_sys::window() else { return };
+    let ctx = ctx.clone();
+    let ouvir = Closure::<dyn FnMut(web_sys::MessageEvent)>::new(move |ev: web_sys::MessageEvent| {
+        if ev.origin() != origem {
+            return;
+        }
+        let Some(fonte) = ev.source() else { return };
+        if wasm_bindgen::JsValue::from(fonte) != wasm_bindgen::JsValue::from(parent.clone()) {
+            return;
+        }
+        let data = ev.data();
+        let campo = |k: &str| js_sys::Reflect::get(&data, &k.into()).ok();
+        if campo("type").and_then(|t| t.as_string()).as_deref() != Some("cadcraft:execute") {
+            return;
+        }
+        let pedido = campo("pedido").and_then(|v| v.as_string()).unwrap_or_default();
+        let Some(id) = campo("id").and_then(|v| v.as_string()) else { return };
+        let params = campo("params")
+            .and_then(|p| js_sys::JSON::stringify(&p).ok())
+            .and_then(|s| s.as_string())
+            .and_then(|s| serde_json::from_str(&s).ok())
+            .unwrap_or(serde_json::json!({}));
+        PEDIDOS.with(|p| p.borrow_mut().push((pedido, id, params)));
+        ctx.request_repaint(); // o app pode estar parado esperando input
+    });
+    let _ = window.add_event_listener_with_callback("message", ouvir.as_ref().unchecked_ref());
+    ouvir.forget(); // vive enquanto a página viver
+}
+
+/// Roda os comandos pedidos pela página e responde a cada um.
+pub fn run_pending(app: &mut CadApp) {
+    let pedidos = PEDIDOS.with(|p| std::mem::take(&mut *p.borrow_mut()));
+    if pedidos.is_empty() {
+        return;
+    }
+    let Some((parent, origem)) = parent_mesma_origem() else { return };
+    for (pedido, id, params) in pedidos {
+        let resposta = match app.run(&id, params) {
+            Ok(result) => serde_json::json!({ "type": "cadcraft:executed", "pedido": pedido, "ok": true, "result": result }),
+            Err(error) => serde_json::json!({ "type": "cadcraft:executed", "pedido": pedido, "ok": false, "error": error }),
+        };
+        if let Ok(obj) = js_sys::JSON::parse(&resposta.to_string()) {
+            let _ = parent.post_message(&obj, &origem);
+        }
+    }
+}
